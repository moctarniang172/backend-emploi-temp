# Copier ce fichier en ".env" et remplir les vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être partagé ou versionné (il contient des secrets).

# Port sur lequel le serveur backend écoute
PORT=8000

# URL de connexion à la base MongoDB
# Exemple local : mongodb://127.0.0.1:27017/emploi_du_temps
# Exemple MongoDB Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/emploi_du_temps
MONGO_URI=mongodb://127.0.0.1:27017/emploi_du_temps

# Clé secrète utilisée pour signer les tokens JWT (mettre une longue chaîne aléatoire en production)
JWT_SECRET=change_moi_avec_une_valeur_secrete_longue_et_aleatoire

# Durée de validité d'un token JWT
JWT_EXPIRES_IN=7d

# URL du frontend, utilisée pour la configuration CORS
FRONTEND_URL=http://localhost:5173

# Identifiants du compte administrateur créé par le script de seed (npm run seed)
SEED_ADMIN_EMAIL=admin@ecole.sn
SEED_ADMIN_PASSWORD=Admin123!
